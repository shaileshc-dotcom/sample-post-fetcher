# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---- OpenAI (optional — powers prompt ranking + AI analysis) ----
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ---- SpeedyIndex (optional — powers the Index Checker) ----
SPEEDYINDEX_API_KEY=your-speedyindex-key

# ---- Google (Docs + Drive) ----
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-sa@project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"
GOOGLE_SHARED_DRIVE_ID=your-shared-drive-id

# ---- Supabase admin (server-only; bypasses RLS — never expose to client) ----
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Missive (Search / Send Email / Follow-ups) ----
MISSIVE_API_TOKEN=your-missive-api-token
# Shared label that holds order threads — name, or the label ID from
# Missive -> Settings -> API -> Resource IDs (ID is more reliable).
MISSIVE_ORDER_LABEL=GPL Order Processing

# ---- Bulk AG (Bulk Article Generator — n8n pipeline) ----
# Production webhook URL of the imported Bulk AG n8n workflow (see n8n/README.md).
# Local dev: http://localhost:5678/webhook/bulk-ag
N8N_BULK_AG_WEBHOOK_URL=http://localhost:5678/webhook/bulk-ag
# Shared secret; MUST match BULK_AG_CALLBACK_SECRET set inside n8n. The callback
# route (/api/bulk-ag/callback) rejects any request whose x-bulk-ag-secret differs.
BULK_AG_CALLBACK_SECRET=generate-a-long-random-string
# Pexels API key — powers real stock images embedded into Bulk AG Google Docs.
# Get one free at https://www.pexels.com/api/. Without it, docs build without images.
PEXELS_API_KEY=your-pexels-api-key

# ---- Follow-up automation (Phase 12) ----
NOTION_TOKEN=secret_your-notion-integration-token
NOTION_DB_ID=your-2026-order-management-database-id
# Vercel Cron sends this as a Bearer token to /api/followups/run.
CRON_SECRET=generate-a-long-random-string
# Shared secret in the Missive rule webhook URL (?secret=...).
FOLLOWUP_WEBHOOK_SECRET=generate-another-long-random-string
FOLLOWUP_FROM_EMAIL=hello@guestpostlinks.net
FOLLOWUP_FROM_NAME=Simon Craig
FOLLOWUP_BILLING_URL=https://your-billing-details-link
# Optional: hours between follow-ups (default 12).
FOLLOWUP_CADENCE_HOURS=12
# Set to 1 for a full rehearsal: runs everything but sends no emails and
# writes nothing to Notion (log rows record "dry_run"). Remove to go live.
FOLLOWUP_DRY_RUN=1


# ---- SearchApi.io (Domain Pages / indexed page-count via Google SERP) ----
# Get a key at searchapi.io (100 free searches). 1 domain lookup = 1 credit.
SEARCHAPI_KEY=your-searchapi-key

# ---- SerpApi.com (alternative SERP provider; selectable in Settings) ----
# ~250 free searches/month. Used when Settings SERP provider = SerpApi.com.
SERPAPI_KEY=your-serpapi-key
